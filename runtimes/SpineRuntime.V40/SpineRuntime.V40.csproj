<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);SPINE_V40</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- The vendored Runtime snapshot is local and read-only; project-owned adapter and shared renderer remain separate. -->
    <Compile Include="src/*.cs" />
    <Compile Include="src/Attachments/*.cs" />
    <Compile Include="../SpineRuntime.V41/CpuRenderer.cs" Link="CpuRenderer.cs" />
    <Compile Include="../SpineRuntime.V41/PngReader.cs" Link="PngReader.cs" />
    <Compile Include="../SpineRuntime.V41/PngWriter.cs" Link="PngWriter.cs" />
    <Compile Include="Adapter.cs" />
    <Compile Include="SharpJson.cs" />
    <ProjectReference Include="../../src/SpineViewerWPF.Application/SpineViewerWPF.Application.csproj" />
  </ItemGroup>
</Project>
